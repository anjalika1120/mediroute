# Optional: enables AI-assisted wording for transfer audit memos.
# Copy this file to .env and replace the placeholder with your own secret.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_SECONDS=8
# NLEM_CATALOG_PATH=C:/path/to/your/nlem_catalog.json

# Gmail SMTP (recommended if using a Google App Password):
# SMTP_USER=mediroute.notifications@gmail.com
# SMTP_PASSWORD=abcdabcdabcdabcd
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Keep SMTP_PASSWORD private. Restart the backend after editing backend/.env.
# Gmail API OAuth is also supported using backend/google_oauth_client.json and setup_gmail_oauth.py.
# MEDIROUTE_PUBLIC_URL=https://your-public-mediroute-host.example
